{
  "name": "tarve",
  "version": "0.1.0",
  "description": "Native Bun/TSX GUI with Taffy layout, Parley text and Vello rendering",
  "license": "UNLICENSED",
  "type": "module",
  "engines": { "bun": ">=1.4.0" },
  "os": ["win32"],
  "cpu": ["x64"],
  "files": ["dist/npm", "dist/types", "native/win32-x64", "README.md", "PERFORMANCE.md"],
  "bin": { "tarve": "./dist/npm/cli.js" },
  "exports": {
    ".": { "types": "./dist/types/core/src/index.d.ts", "default": "./dist/npm/index.js" },
    "./jsx-runtime": { "types": "./dist/types/core/src/jsx-runtime.d.ts", "default": "./dist/npm/jsx-runtime.js" },
    "./jsx-dev-runtime": { "types": "./dist/types/core/src/jsx-dev-runtime.d.ts", "default": "./dist/npm/jsx-dev-runtime.js" },
    "./build": { "types": "./dist/types/core/build.d.ts", "default": "./dist/npm/build.js" },
    "./protocol": { "types": "./dist/types/protocol/src/index.d.ts", "default": "./dist/npm/protocol.js" },
    "./assets": { "types": "./dist/types/core/src/assets.d.ts" },
    "./package.json": "./package.json"
  },
  "imports": { "#tarve/runtime": "./dist/npm/runtime.js", "#tarve/assets": "./dist/npm/embedded-assets.js" },
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts --release",
    "build:exe": "bun scripts/build.ts --exe",
    "build:native": "bun scripts/build.ts",
    "package": "bun scripts/package.ts",
    "prepack": "bun scripts/package.ts",
    "pack": "bun pm pack --ignore-scripts --destination dist",
    "start": "bun run setup:examples && bun examples/basic.tsx",
    "check": "tsc --noEmit",
    "lint": "cargo clippy --manifest-path native/Cargo.toml --all-targets -- -D warnings",
    "setup:examples": "bun scripts/setup-examples.ts",
    "verify": "bun scripts/verify.ts",
    "test": "bun test packages && cargo test --manifest-path native/Cargo.toml",
    "smoke": "bun run pack && bun run setup:examples && bun scripts/smoke.ts",
    "smoke:controls": "bun run pack && bun run setup:examples && bun scripts/smoke-controls.ts",
    "smoke:virtual-list": "bun run pack && bun run setup:examples && bun scripts/smoke-virtual-list.ts",
    "smoke:exe": "bun scripts/smoke-exe.ts",
    "smoke:package": "bun scripts/smoke-package.ts",
    "bench": "bun scripts/benchmark.tsx"
  },
  "devDependencies": { "@types/bun": "^1.3.0", "typescript": "^5.9.0" }
}
