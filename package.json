{
  "name": "@tarve/core",
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omarcosr/tarve.git"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/types/core/src/index.d.ts",
      "default": "./dist/npm/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/types/core/src/jsx-runtime.d.ts",
      "default": "./dist/npm/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/types/core/src/jsx-dev-runtime.d.ts",
      "default": "./dist/npm/jsx-dev-runtime.js"
    },
    "./build": {
      "types": "./dist/types/core/build.d.ts",
      "default": "./dist/npm/build.js"
    },
    "./protocol": {
      "types": "./dist/types/protocol/src/index.d.ts",
      "default": "./dist/npm/protocol.js"
    },
    "./assets": {
      "types": "./dist/types/core/src/assets.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tarve": "./dist/npm/cli.js"
  },
  "bugs": {
    "url": "https://github.com/omarcosr/tarve/issues"
  },
  "cpu": [
    "x64"
  ],
  "description": "Native Bun/TSX GUI with Taffy layout, Parley text and Vello rendering",
  "engines": {
    "bun": ">=1.4.0"
  },
  "files": [
    "CHANGELOG.md",
    "dist/npm",
    "dist/types",
    "native/win32-x64",
    "native/linux-x64",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/omarcosr/tarve#readme",
  "imports": {
    "#tarve/runtime": "./dist/npm/runtime.js",
    "#tarve/assets": "./dist/npm/embedded-assets.js"
  },
  "keywords": [
    "gui",
    "desktop",
    "native",
    "bun",
    "tsx",
    "jsx",
    "ui",
    "vello",
    "taffy",
    "windows",
    "linux"
  ],
  "license": "Apache-2.0",
  "os": [
    "win32",
    "linux"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:example": "bun scripts/dev.ts --entry examples/basic.tsx",
    "build": "bun scripts/build.ts --release",
    "build:exe": "bun scripts/build.ts --exe",
    "build:example": "bun scripts/build.ts --exe --entry examples/basic.tsx",
    "build:native": "bun scripts/build.ts",
    "build:wasm": "bun packages/headless/scripts/build-wasm.ts",
    "package": "bun scripts/package.ts",
    "package:local": "bun scripts/package.ts --local",
    "package:native": "bun scripts/package.ts --native-only",
    "prepack": "bun scripts/prepack.ts",
    "pack": "bun scripts/pack.ts",
    "start:example": "bun run setup:examples && bun examples/basic.tsx",
    "check": "bun node_modules/typescript/bin/tsc --noEmit",
    "lint": "cargo clippy --manifest-path native/Cargo.toml --all-targets -- -D warnings",
    "setup:examples": "bun scripts/setup-examples.ts",
    "install:examples": "bun install --cwd examples --frozen-lockfile",
    "verify": "bun scripts/verify.ts",
    "release:check": "bun run verify",
    "release:policy": "bun scripts/release-policy.ts",
    "release:build": "bun scripts/release.ts",
    "version:check": "bun scripts/version-policy.ts --check",
    "version:set": "bun scripts/version-policy.ts --set",
    "test": "bun test packages/core && cargo test --manifest-path native/Cargo.toml",
    "test:headless": "bun test packages/headless",
    "test:package-clean": "bun test scripts/package-output.test.ts",
    "test:release-policy": "bun test scripts/version-policy.test.ts scripts/release-policy.test.ts",
    "test:visual": "bun run setup:examples && bun scripts/visual-regression.tsx",
    "smoke": "bun run build:native && bun run setup:examples && bun scripts/smoke.ts",
    "smoke:controls": "bun run build:native && bun run setup:examples && bun scripts/smoke-controls.ts",
    "smoke:virtual-list": "bun run build:native && bun run setup:examples && bun scripts/smoke-virtual-list.ts",
    "smoke:rich-content": "bun run build:native && bun scripts/smoke-rich-content.ts",
    "smoke:motion": "bun run build:native && bun scripts/smoke-motion.tsx",
    "smoke:editor": "bun run build:native && bun scripts/smoke-editor.tsx",
    "smoke:steady-frames": "bun run build:native && bun scripts/smoke-steady-frames.tsx",
    "bench:compare": "bun scripts/bench-compare.ts",
    "smoke:devtools": "bun run build:native && bun scripts/smoke-devtools.ts",
    "smoke:accessibility": "bun run build:native && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-accessibility.ps1",
    "smoke:exe": "bun scripts/smoke-exe.ts",
    "smoke:package": "bun scripts/smoke-package.ts",
    "bench": "bun scripts/benchmark.tsx"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ]
}
