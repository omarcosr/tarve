{
  "name": "@tarve/svelte",
  "version": "0.6.0",
  "description": "Svelte 5 components in native Tarve windows",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "tarve",
    "svelte",
    "gui",
    "desktop",
    "native"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omarcosr/tarve.git",
    "directory": "packages/svelte"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
