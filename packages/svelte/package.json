    "./plugin": "./src/plugin.ts",
    "./bun": "./src/bun.ts",
    "./css": "./src/css.ts",
    "./dom": "./src/dom.ts",
    "./install": "./src/install.ts",
    "./bun-preload": "./src/bun-preload.ts",
    "./elements": {
      "types": "./src/elements.d.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "dependencies": {
    "svelte": "^5.57.2"
  },
  "peerDependencies": {
    "@tarve/core": "^0.6.0"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=26.10.0"
