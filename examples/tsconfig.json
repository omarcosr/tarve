{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@tarve/core",
    "types": ["bun", "@tarve/core/assets"],
    // Linked packages (@tarve/svelte, @tarve/react-icons) resolve their imports from here, not from their source folder.
    "preserveSymlinks": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "**/dist", "studio/studio-samples", "microts-prototype/app", "microts-prototype/.pocketjs"]
}
