{
  "name": "@tarve/examples",
  "private": true,
  "type": "module",
  "scripts": {
    "basic": "tarve run basic/basic.tsx",
    "counter": "tarve run counter/counter.tsx",
    "components": "tarve run components/components.tsx",
    "rich-content": "tarve run rich-content/rich-content.tsx",
    "diff": "tarve run diff/diff.tsx",
    "forms": "tarve run forms/forms.tsx",
    "intrinsics": "tarve run intrinsics/intrinsics.tsx",
    "large-list": "tarve run large-list/large-list.tsx",
    "motion": "tarve run motion/motion.tsx",
    "studio": "tarve run studio/studio.tsx",
    "text": "tarve run text/text.tsx",
    "html": "tarve run html/html.tsx",
    "performance": "tarve run performance/performance.tsx",
    "youtube-music": "tarve run youtube-music/youtube-music.tsx",
    "pulse": "tarve run pulse/pulse.tsx",
    "check": "bun node_modules/typescript/bin/tsc --noEmit && bun node_modules/typescript/bin/tsc --noEmit -p studio/studio-samples && bun studio/studio-samples/generate.ts --check",
    "build:basic": "tarve build basic/basic.tsx --outfile dist/Basic.exe",
    "build:counter": "tarve build counter/counter.tsx --outfile dist/Counter.exe",
    "build:components": "tarve build components/components.tsx --outfile dist/Components.exe",
    "build:rich-content": "tarve build rich-content/rich-content.tsx --outfile dist/RichContent.exe",
    "build:diff": "tarve build diff/diff.tsx --outfile dist/Diff.exe",
    "build:forms": "tarve build forms/forms.tsx --outfile dist/Forms.exe",
    "build:intrinsics": "tarve build intrinsics/intrinsics.tsx --outfile dist/Intrinsics.exe",
    "build:large-list": "tarve build large-list/large-list.tsx --outfile dist/LargeList.exe",
    "build:motion": "tarve build motion/motion.tsx --outfile dist/Motion.exe",
    "build:studio": "tarve build studio/studio.tsx --outfile dist/Studio.exe",
    "build:text": "tarve build text/text.tsx --outfile dist/Text.exe",
    "build:html": "tarve build html/html.tsx --outfile dist/Html.exe",
    "build:performance": "tarve build performance/performance.tsx --outfile dist/Performance.exe",
    "build:player": "tarve build player/player.tsx --outfile dist/Player.exe",
    "build:fps": "tarve build fps/fps.tsx --outfile dist/Fps.exe",
    "build:youtube-music": "tarve build youtube-music/youtube-music.tsx --outfile dist/YouTubeMusic.exe",
    "build:pulse": "tarve build pulse/pulse.tsx --outfile dist/Pulse.exe"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tabler/icons-react": "^3.48.0",
    "@tarve/react-icons": "file:../packages/react-icons",
    "lucide-react": "^1.47.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "tarve": {
    "publisher": "Tarve",
    "apps": {
      "pulse/pulse.tsx": {
        "name": "Pulse",
        "description": "System monitor built with Tarve",
        "icon": "pulse/icon.png",
        "appId": "Tarve.Examples.Pulse"
      },
      "youtube-music/youtube-music.tsx": {
        "name": "YouTube Music (Tarve)",
        "description": "YouTube Music client built with Tarve",
        "icon": "youtube-music/icon.png",
        "appId": "Tarve.Examples.YouTubeMusic"
      }
    }
  }
}
