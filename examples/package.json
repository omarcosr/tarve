{
  "name": "@tarve/examples",
  "private": true,
  "type": "module",
  "scripts": {
    "basic": "tarve run basic.tsx",
    "counter": "tarve run counter.tsx",
    "components": "tarve run components.tsx",
    "rich-content": "tarve run rich-content.tsx",
    "diff": "tarve run diff.tsx",
    "forms": "tarve run forms.tsx",
    "intrinsics": "tarve run intrinsics.tsx",
    "large-list": "tarve run large-list.tsx",
    "motion": "tarve run motion.tsx",
    "studio": "tarve run studio.tsx",
    "text": "tarve run text.tsx",
    "html": "tarve run html.tsx",
    "performance": "tarve run performance.tsx",
    "check": "bun node_modules/typescript/bin/tsc --noEmit && bun node_modules/typescript/bin/tsc --noEmit -p studio-samples && bun studio-samples/generate.ts --check",
    "build:basic": "tarve build basic.tsx --outfile dist/Basic.exe",
    "build:counter": "tarve build counter.tsx --outfile dist/Counter.exe",
    "build:components": "tarve build components.tsx --outfile dist/Components.exe",
    "build:rich-content": "tarve build rich-content.tsx --outfile dist/RichContent.exe",
    "build:diff": "tarve build diff.tsx --outfile dist/Diff.exe",
    "build:forms": "tarve build forms.tsx --outfile dist/Forms.exe",
    "build:intrinsics": "tarve build intrinsics.tsx --outfile dist/Intrinsics.exe",
    "build:large-list": "tarve build large-list.tsx --outfile dist/LargeList.exe",
    "build:motion": "tarve build motion.tsx --outfile dist/Motion.exe",
    "build:studio": "tarve build studio.tsx --outfile dist/Studio.exe",
    "build:text": "tarve build text.tsx --outfile dist/Text.exe",
    "build:html": "tarve build html.tsx --outfile dist/Html.exe",
    "build:performance": "tarve build performance.tsx --outfile dist/Performance.exe"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tabler/icons-react": "^3.48.0",
    "@tarve/react-icons": "file:../packages/react-icons",
    "lucide-react": "^1.47.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
